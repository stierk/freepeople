; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Freepeople"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

GlobalInventory="*res://scripts/autoload/GlobalInventory.gd"
GameState="*res://scripts/autoload/GameState.gd"
WorldGrid="*res://scripts/autoload/WorldGrid.gd"
BuildingManager="*res://scripts/autoload/BuildingManager.gd"
EconomyManager="*res://scripts/autoload/EconomyManager.gd"
SimulationManager="*res://scripts/autoload/SimulationManager.gd"
SaveLoadManager="*res://scripts/autoload/SaveLoadManager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
2d/snap_2d_transforms_to_pixel=true
